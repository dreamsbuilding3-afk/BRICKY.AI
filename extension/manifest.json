{
  "manifest_version": 3,
  "name": "Bricky – Envoyer une annonce",
  "short_name": "Bricky",
  "version": "1.0.0",
  "description": "Envoie l'annonce immobilière que tu regardes à Bricky en un clic : l'analyse se remplit toute seule.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Envoyer à Bricky",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Ouvrir Bricky sur cette annonce"
    }
  }
}
